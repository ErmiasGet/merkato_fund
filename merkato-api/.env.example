NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME
DATABASE_SSL=false
DB_POOL_MAX=10
WEB_ORIGINS=http://localhost:5173,http://localhost:5174
SESSION_COOKIE_NAME=merkato_session
SESSION_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-long-password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Merkato Fund <no-reply@example.com>
PUBLIC_SITE_URL=http://localhost:5173
ADMIN_SITE_URL=http://localhost:5174
GOOGLE_CLOUD_TRANSLATE_API_KEY=
COOKIE_SAME_SITE=lax
